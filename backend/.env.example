DATABASE_URL=postgresql://ticketing_user:ticketing_pass@db:5432/ticketing_db
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

